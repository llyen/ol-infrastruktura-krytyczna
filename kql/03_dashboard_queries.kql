// =====================================================================
// 03 — Zapytania Real-Time Dashboard "Efekt domina — obraz operacyjny"
// Kazde zapytanie odpowiada jednemu kaflowi. Parametry dashboardu:
//   _startTime, _endTime (suwak czasu), _voivodeship, _system (multi-select)
//
// Zegar: kafle stanu korzystaja z CiNodeAt(_end) zamiast CiNodeCurrent,
// dzieki czemu suwak czasu przewija przebieg kaskady. Funkcje WindowStart
// i WindowEnd przelaczaja kafle na szczyt kryzysu, gdy wybrany zakres nie
// pokrywa sie z danymi scenariusza (wrzesien 2026).
//
// Plik jest zrodlem prawdy dla skryptu deploy\09_realtime_dashboard.py,
// ktory buduje z niego definicje dashboardu. Linia "// --- KAFEL n: tytul"
// rozpoczyna kafel i jest jego tytulem.
// =====================================================================

// --- KAFEL 1: stan systemow IK w jednej liczbie -----------------------
let _end = WindowEnd(_startTime, _endTime);
let _stan =
    CiNodeAt(_end)
    | join kind=leftouter CiNode on node_id
    | where isnull(_voivodeship) or array_length(_voivodeship) == 0 or voivodeship_code in (_voivodeship)
    | summarize nodes = count(),
                down = countif(status == "down"),
                degraded = countif(status == "degraded"),
                on_backup = countif(on_backup_power == true),
                k1_down = countif(status == "down" and criticality_class == "K1")
    | extend availability_pct = round(100.0 * (nodes - down) / nodes, 1);
union
    (_stan | project wskaznik = "Dostepnosc obiektow IK [%]", wartosc = availability_pct),
    (_stan | project wskaznik = "Obiekty niedzialajace", wartosc = todouble(down)),
    (_stan | project wskaznik = "Obiekty o obnizonej wydajnosci", wartosc = todouble(degraded)),
    (_stan | project wskaznik = "Na zasilaniu rezerwowym", wartosc = todouble(on_backup)),
    (_stan | project wskaznik = "Obiekty klasy K1 w awarii", wartosc = todouble(k1_down))

// --- KAFEL 2: awarie wg systemu IK (11 systemow ustawowych) -----------
let _end = WindowEnd(_startTime, _endTime);
CiNodeAt(_end)
| join kind=inner CiNode on node_id
| where isnull(_voivodeship) or array_length(_voivodeship) == 0 or voivodeship_code in (_voivodeship)
| summarize nodes = count(),
            down = countif(status == "down"),
            degraded = countif(status == "degraded")
  by system_code
| join kind=leftouter (CiSystem | project system_code, system_name) on system_code
| extend system = coalesce(system_name, system_code)
| project system, nodes, down, degraded, down_pct = round(100.0 * down / nodes, 1)
| order by down_pct desc

// --- KAFEL 3: mapa wezlow niedzialajacych -----------------------------
let _end = WindowEnd(_startTime, _endTime);
CiNodeAt(_end)
| where status in ("down", "degraded")
| join kind=inner CiNode on node_id
| where isnull(_voivodeship) or array_length(_voivodeship) == 0 or voivodeship_code in (_voivodeship)
| where isnull(_system) or array_length(_system) == 0 or system_code in (_system)
| project node_name, node_type, system_code, criticality_class, status,
          lat, lon, population_served, operator_name, on_backup_power
| order by population_served desc

// --- KAFEL 4: przebieg kaskady w czasie (fale skutkow) ----------------
let _end = WindowEnd(_startTime, _endTime);
let _start = WindowStart(_startTime, _endTime);
CiNodeStatus
| where event_time between (_start .. _end)
| where status != "operational"
| summarize first_down = min(event_time) by node_id, system_code
| summarize nodes_down = count() by bin(first_down, 1h), system_code
| order by first_down asc

// --- KAFEL 5: kolejka dowozu paliwa do agregatow ----------------------
let _end = WindowEnd(_startTime, _endTime);
FuelRunout(8.0, _end)
| where isnull(_voivodeship) or array_length(_voivodeship) == 0 or voivodeship_code in (_voivodeship)
| project node_name, node_type, system_code, criticality_class,
          voivodeship_code, operator_name,
          hours_left = backup_fuel_hours_left, population_served
| take 50

// --- KAFEL 6: prognoza kaskady na najblizsze 24 h ---------------------
let _end = WindowEnd(_startTime, _endTime);
CascadeForecast(24.0, _end)
| project target_node_id, any_target_name, any_target_type, any_target_system,
          any_criticality, earliest_impact,
          hours_left = round((earliest_impact - _end) / 1h, 1),
          impact_share_lost = round(impact_share_lost, 2),
          any_population
| take 40

// --- KAFEL 7: presja powodziowa (zdarzenie inicjujace) ----------------
let _end = WindowEnd(_startTime, _endTime);
FloodPressure(_end)
| join kind=leftouter (CiVoivodeship | project voivodeship_code, voivodeship_name) on voivodeship_code
| project wojewodztwo = coalesce(voivodeship_name, voivodeship_code),
          gauges, gauges_alarm, gauges_warning, max_exceedance_cm, alarm_pct
| order by gauges_alarm desc

// --- KAFEL 8: meldunki operatorow IK wymagajace decyzji ---------------
let _end = WindowEnd(_startTime, _endTime);
let _start = WindowStart(_startTime, _endTime);
CiOperatorReport
| where event_time between (_start .. _end)
| where severity == "critical" or support_requested == true
| join kind=leftouter CiNode on node_id
| project event_time, operator_name, node_name, node_type, report_kind,
          severity, eta_restore_hours, support_requested, channel, spo10_agreement
| order by event_time desc
| take 60

// --- KAFEL 9: obiekty krytyczne bez umowy SPO-10 ----------------------
let _end = WindowEnd(_startTime, _endTime);
CiNodeAt(_end)
| where status in ("down", "degraded")
| join kind=inner CiNode on node_id
| where spo10_agreement == false and criticality_class in ("K1", "K2")
| summarize nodes = count(), population = sum(population_served) by operator_name, system_code
| order by population desc

// --- KAFEL 10: ranking kaskadowy — gdzie awaria zaboli najbardziej ----
let _end = WindowEnd(_startTime, _endTime);
CascadeCentrality
| where isnull(_voivodeship) or array_length(_voivodeship) == 0 or voivodeship_code in (_voivodeship)
| where cascade_tier in ("krytyczny", "wysoki")
| join kind=leftouter (CiNodeAt(_end) | project node_id, status) on node_id
| project node_name, node_type, system_code, voivodeship_code, cascade_index,
          cascade_nodes, cascade_systems, cascade_population, status
| order by cascade_index desc
| take 25

// --- KAFEL 11: wezly bez zasilania rezerwowego, ktore juz sa w awarii -
let _end = WindowEnd(_startTime, _endTime);
CiNodeAt(_end)
| where status == "down"
| join kind=inner CiNode on node_id
| where backup_type == "none"
| where isnull(_system) or array_length(_system) == 0 or system_code in (_system)
| project node_name, node_type, system_code, criticality_class,
          voivodeship_code, operator_name, population_served, event_time
| order by population_served desc
