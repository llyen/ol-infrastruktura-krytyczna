// =====================================================================
// 02 — Update policies i tabele materializowane
// Cel: dyzurny ma odpowiedz w sekundach, bez przeliczania calego strumienia.
// =====================================================================

// ---------------------------------------------------------------------
// Rozpakowanie surowego JSON z Eventstream
// ---------------------------------------------------------------------
.create-or-alter function ParseCiNodeStatus() {
    CiNodeStatusRaw
    | extend
        event_time = todatetime(payload.event_time),
        node_id = tostring(payload.node_id),
        system_code = tostring(payload.system_code),
        gmina_code = tostring(payload.gmina_code),
        powiat_code = tostring(payload.powiat_code),
        voivodeship_code = tostring(payload.voivodeship_code),
        status = tostring(payload.status),
        load_pct = toreal(payload.load_pct),
        on_backup_power = tobool(payload.on_backup_power),
        backup_fuel_hours_left = toreal(payload.backup_fuel_hours_left),
        water_level_margin_m = toreal(payload.water_level_margin_m),
        population_served = tolong(payload.population_served)
    | project event_time, node_id, system_code, gmina_code, powiat_code, voivodeship_code,
              status, load_pct, on_backup_power, backup_fuel_hours_left,
              water_level_margin_m, population_served
}

.alter table CiNodeStatus policy update
```[{"IsEnabled": true, "Source": "CiNodeStatusRaw", "Query": "ParseCiNodeStatus()", "IsTransactional": true}]```

.create-or-alter function ParseCiOperatorReport() {
    CiOperatorReportRaw
    | extend
        event_time = todatetime(payload.event_time),
        report_id = tostring(payload.report_id),
        node_id = tostring(payload.node_id),
        system_code = tostring(payload.system_code),
        voivodeship_code = tostring(payload.voivodeship_code),
        powiat_code = tostring(payload.powiat_code),
        operator_name = tostring(payload.operator_name),
        report_kind = tostring(payload.report_kind),
        severity = tostring(payload.severity),
        eta_restore_hours = toreal(payload.eta_restore_hours),
        support_requested = tobool(payload.support_requested),
        channel = tostring(payload.channel)
    | project event_time, report_id, node_id, system_code, voivodeship_code, powiat_code,
              operator_name, report_kind, severity, eta_restore_hours, support_requested, channel
}

.alter table CiOperatorReport policy update
```[{"IsEnabled": true, "Source": "CiOperatorReportRaw", "Query": "ParseCiOperatorReport()", "IsTransactional": true}]```

.create-or-alter function ParseHydroReading() {
    HydroReadingRaw
    | extend
        event_time = todatetime(payload.event_time),
        gauge_id = tostring(payload.gauge_id),
        voivodeship_code = tostring(payload.voivodeship_code),
        powiat_code = tostring(payload.powiat_code),
        gmina_code = tostring(payload.gmina_code),
        water_level_cm = toreal(payload.water_level_cm),
        warning_level_cm = toint(payload.warning_level_cm),
        alarm_level_cm = toint(payload.alarm_level_cm),
        state = tostring(payload.state)
    | project event_time, gauge_id, voivodeship_code, powiat_code, gmina_code,
              water_level_cm, warning_level_cm, alarm_level_cm, state
}

.alter table HydroReading policy update
```[{"IsEnabled": true, "Source": "HydroReadingRaw", "Query": "ParseHydroReading()", "IsTransactional": true}]```

// ---------------------------------------------------------------------
// Aktualny stan kazdego wezla IK — podstawa wszystkich kafli operacyjnych
// ---------------------------------------------------------------------
.create-or-alter materialized-view CiNodeCurrent on table CiNodeStatus {
    CiNodeStatus
    | summarize arg_max(event_time, status, load_pct, on_backup_power,
                        backup_fuel_hours_left, water_level_margin_m,
                        population_served, voivodeship_code, powiat_code,
                        gmina_code, system_code)
      by node_id
}

// ---------------------------------------------------------------------
// Godzinowy profil awarii per system — trend, nie tylko punkt w czasie
// ---------------------------------------------------------------------
.create-or-alter materialized-view CiOutageHourly on table CiNodeStatus {
    CiNodeStatus
    | where status != "operational"
    | summarize nodes_affected = dcount(node_id),
                nodes_down = dcountif(node_id, status == "down"),
                population_served = sum(population_served)
      by bin(event_time, 1h), system_code, voivodeship_code
}

// ---------------------------------------------------------------------
// Funkcje operacyjne
// ---------------------------------------------------------------------

// ---------------------------------------------------------------------
// Zegar scenariusza
// Dane demo sa datowane na wrzesien 2026, wiec ago()/now() nie zwracalyby
// nic. Wszystkie funkcje operacyjne kotwicza sie do najnowszego zdarzenia
// w strumieniu — dziala to zarowno na danych historycznych (wsad), jak i
// na zywo (wtedy ScenarioNow() = biezacy czas).
// ---------------------------------------------------------------------

.create-or-alter function ScenarioNow() {
    toscalar(CiNodeCurrent | summarize max_event_time = max(event_time))
}

// Poczatek okna danych — granica dolna scenariusza
.create-or-alter function ScenarioStart() {
    toscalar(CiNodeStatus | summarize min_event_time = min(event_time))
}

// Szczyt kryzysu — domyslna kotwica dla dashboardu demo
.create-or-alter function ScenarioPeak() {
    toscalar(
        CiNodeStatus
        | where status == "down"
        | summarize nodes_down = dcount(node_id) by hour = bin(event_time, 1h)
        | top 1 by nodes_down desc
        | project hour
    )
}

// Stan kazdego wezla IK na zadany moment (CiNodeCurrent = stan na koniec okna)
.create-or-alter function CiNodeAt(at: datetime) {
    CiNodeStatus
    | where event_time <= at
    | summarize arg_max(event_time, status, load_pct, on_backup_power,
                        backup_fuel_hours_left, water_level_margin_m,
                        population_served, voivodeship_code, powiat_code,
                        gmina_code, system_code)
      by node_id
}

// ---------------------------------------------------------------------
// Okno dashboardu. Suwak czasu Real-Time Dashboard domyslnie pokazuje
// ostatnia godzine, a dane scenariusza leza we wrzesniu 2026 — kafle byly
// by puste przy pierwszym otwarciu. Jesli wybrany zakres nie pokrywa sie
// z danymi, kafle przelaczaja sie na szczyt kryzysu; wybor wlasnego okna
// z danymi jest respektowany.
// ---------------------------------------------------------------------

.create-or-alter function WindowEnd(from_time: datetime, to_time: datetime) {
    iff(to_time < ScenarioStart() or from_time > ScenarioNow(), ScenarioPeak() + 6h, to_time)
}

.create-or-alter function WindowStart(from_time: datetime, to_time: datetime) {
    iff(to_time < ScenarioStart() or from_time > ScenarioNow(),
        ScenarioPeak() + 6h - (to_time - from_time), from_time)
}

// Wezly, ktorym konczy sie paliwo w agregacie — kolejka dowozu paliwa
.create-or-alter function FuelRunout(threshold_hours: real = 6.0, at: datetime = datetime(null)) {
    CiNodeAt(iff(isnull(at), ScenarioPeak(), at))
    | where on_backup_power == true and backup_fuel_hours_left <= threshold_hours
    | join kind=leftouter CiNode on node_id
    | project node_id, node_name, node_type, system_code, criticality_class,
              voivodeship_code, powiat_code, operator_name,
              backup_fuel_hours_left, population_served, event_time
    | order by backup_fuel_hours_left asc
}

// Wezly krytyczne, ktore przestaly dzialac — wejscie do reguly Activatora
.create-or-alter function CriticalNodesDown(at: datetime = datetime(null)) {
    CiNodeAt(iff(isnull(at), ScenarioPeak(), at))
    | where status == "down"
    | join kind=inner CiNode on node_id
    | where criticality_class == "K1"
    | project node_id, node_name, node_type, system_code, voivodeship_code,
              operator_name, spo10_agreement, population_served, event_time
    | order by population_served desc
}

// Prognoza kaskady: kto zalezy od wezlow, ktore wlasnie padly, i kiedy to odczuje
.create-or-alter function CascadeForecast(horizon_hours: real = 24.0, at: datetime = datetime(null)) {
    let _at = iff(isnull(at), ScenarioPeak(), at);
    let down_now = CiNodeAt(_at) | where status == "down" | project source_node_id = node_id, down_since = event_time;
    CiDependency
    | join kind=inner down_now on source_node_id
    | join kind=leftouter (CiNode | project target_node_id = node_id, target_name = node_name,
                                            target_type = node_type, target_system = system_code,
                                            autonomy_hours, backup_type, criticality_class,
                                            target_population = population_served)
      on target_node_id
    | extend buffer_hours = iff(dependency_type in ("electricity", "generation"), autonomy_hours,
                           iff(dependency_type == "fuel", autonomy_hours, 0.0))
    | extend expected_impact_time = down_since + totimespan((lag_hours + buffer_hours) * 1h)
    | extend hours_to_impact = (expected_impact_time - _at) / 1h
    | where hours_to_impact <= horizon_hours
    | summarize impact_share_lost = sum(impact_share),
                earliest_impact = min(expected_impact_time),
                sources_down = dcount(source_node_id),
                any_target_name = any(target_name),
                any_target_type = any(target_type),
                any_target_system = any(target_system),
                any_criticality = any(criticality_class),
                any_population = any(target_population)
      by target_node_id
    | where impact_share_lost >= 0.5
    | order by earliest_impact asc
}

// Stan zagrozenia powodziowego per wojewodztwo (zdarzenie inicjujace)
.create-or-alter function FloodPressure(at: datetime = datetime(null)) {
    let _at = iff(isnull(at), ScenarioPeak(), at);
    HydroReading
    | where event_time <= _at
    | summarize arg_max(event_time, water_level_cm, alarm_level_cm, state) by gauge_id, voivodeship_code
    | summarize gauges = count(),
                gauges_alarm = countif(state == "alarm"),
                gauges_warning = countif(state == "ostrzegawczy"),
                max_exceedance_cm = max(water_level_cm - alarm_level_cm)
      by voivodeship_code
    | extend alarm_pct = round(100.0 * gauges_alarm / gauges, 1)
    | order by gauges_alarm desc
}
